# === DEMO MODE - Конфигурация для экспертной проверки ===
# Этот файл содержит настройки для работы в демонстрационном режиме
# В demo режиме используются предзаписанные mock данные вместо реальных API запросов

# === DEMO MODE ===
DEMO_MODE=true

# === OPENROUTER API (DeepSeek V3.2) ===
# В demo режиме ключи не требуются
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === SERP API (SerpAPI) ===
# В demo режиме ключи не требуются
SERPAPI_KEY=

# === APPLICATION ===
ENVIRONMENT=production
LOG_LEVEL=INFO
TASK_TIMEOUT_SECONDS=300
MAX_RETRIES=3

# === STORAGE BACKEND ===
STORAGE_BACKEND=memory

# Redis connection (not needed in demo mode)
REDIS_URL=redis://redis:6379/0

# === CONTENT LIMITS ===
MIN_CONTENT_LENGTH=500
MAX_CONTENT_LENGTH=50000
SIMILARITY_THRESHOLD=85

# === BLACKLIST DOMAINS ===
BLACKLIST_DOMAINS=avito.ru,drom.ru,auto.ru,ozon.ru,wildberries.ru,yandex.ru,google.com

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
