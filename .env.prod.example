# === PRODUCTION CONFIGURATION ===

# === OPENROUTER API ===
OPENROUTER_API_KEY=sk-or-v1-PRODUCTION_KEY
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === SERP API ===
SERPAPI_KEY=PRODUCTION_SERPAPI_KEY

# === APPLICATION ===
ENVIRONMENT=production
LOG_LEVEL=INFO
TASK_TIMEOUT_SECONDS=300
MAX_RETRIES=3

# === STORAGE BACKEND ===
STORAGE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your_strong_redis_password_here

# PostgreSQL (future)
# DATABASE_URL=postgresql://seo_user:strong_password@postgres:5432/seo_analyzer
# POSTGRES_PASSWORD=your_strong_postgres_password_here

# === CONTENT LIMITS ===
MIN_CONTENT_LENGTH=500
MAX_CONTENT_LENGTH=50000
SIMILARITY_THRESHOLD=85

# === BLACKLIST DOMAINS ===
BLACKLIST_DOMAINS=avito.ru,drom.ru,auto.ru,ozon.ru,wildberries.ru,yandex.ru,google.com

# === SERP FETCHING ===
SERP_FETCH_MULTIPLIER=3

# === API ===
API_HOST=0.0.0.0
API_PORT=8000