# === OPENROUTER API (DeepSeek V3.2) ===
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === SERP API (SerpAPI) ===
SERPAPI_KEY=YOUR_SERPAPI_KEY_HERE

# === APPLICATION ===
ENVIRONMENT=development
LOG_LEVEL=INFO
TASK_TIMEOUT_SECONDS=300
MAX_RETRIES=3

# === STORAGE BACKEND ===
# Options: memory (dev), redis (prod), postgres (future)
STORAGE_BACKEND=memory

# Redis connection (for production)
REDIS_URL=redis://redis:6379/0

# PostgreSQL connection (for future)
# DATABASE_URL=postgresql://seo_user:seo_password@postgres:5432/seo_analyzer

# === CONTENT LIMITS ===
MIN_CONTENT_LENGTH=500
MAX_CONTENT_LENGTH=50000
SIMILARITY_THRESHOLD=85

# === BLACKLIST DOMAINS ===
BLACKLIST_DOMAINS=avito.ru,drom.ru,auto.ru,ozon.ru,wildberries.ru,yandex.ru,google.com

# === SERP FETCHING ===
# Multiplier for fetching extra URLs to compensate for parsing failures
# If depth=10, system will fetch 10*SERP_FETCH_MULTIPLIER URLs and take first 10 successful
SERP_FETCH_MULTIPLIER=3

# === API ===
API_HOST=0.0.0.0
API_PORT=8000